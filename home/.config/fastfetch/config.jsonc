// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "",
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            // draw borders first to make colors of left and right border consistant
            "key": "user",
            "type": "title",
            "format": "{user-name}",
            "keyColor": "31"
        },
        {
            "key": "host",
            "type": "title",
            "format": "{host-name}",
            "keyColor": "32"

        },
        {
            "key": "uptime",
            "type": "uptime",
            "keyColor": "33",
            "format": "{days}d {hours}h {minutes}m {seconds}s"
        },
        {
            "key": "os",
            "type": "os",
            "keyColor": "34",
            "format": "{name}"
        },
        {
            "key": "kernel",
            "type": "kernel",
            "keyColor": "35",
            "format": "{release}"
        },
        {
            "key": "desktop",
            "type": "de",
            "keyColor": "36"
        },
        {
            "key": "term",
            "type": "terminal",
            "keyColor": "31",
            "format": "{process-name}"
        },
        {
            "key": "shell",
            "type": "shell",
            "keyColor": "32",
            "format": "{process-name}"
        },
        {
            "key": "wm",
            "type": "wm",
            "keyColor": "36",
            "format": "{process-name}"
        },
        {
            "key": "cpu",
            "type": "cpu",
            "keyColor": "33",
            "format": "{cores-physical}-core @ {freq-max}"
        },
        {
            "key": "memory",
            "type": "memory",
            "keyColor": "34",
            "format": "{total}"
        },
        {
            "key": "disk",
            "type": "disk",
            "folders": "/",
            "keyColor": "35",
            "format": "{size-total} [{filesystem}]"
        }
    ]
}
