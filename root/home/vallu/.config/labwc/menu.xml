<?xml version="1.0" ?>
<openbox_menu>
  <menu id="root-menu" label="Root menu">
    <item label="Browser"><action name="Execute" command="firefox"/></item>
    <item label="Terminal"><action name="Execute" command="alacritty"/></item>
    <item label="Exit labwc"><action name="Exit"/></item>
  </menu>

  <menu id="client-menu" label="Application menu">
    <item label="Toggle magnifier">
      <action name="ToggleMagnify" />
    </item>
    <separator />
    <item label="Toggle always on top">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <item label="Toggle fullscreen">
      <action name="ToggleFullscreen" />
    </item>
    <separator />
    <item label="Minimise window">
      <action name="Iconify" />
    </item>
    <item label="Toggle maximise">
      <action name="ToggleMaximize" />
    </item>
    <item label="Close window">
      <action name="Close" />
    </item>
  </menu>
</openbox_menu>