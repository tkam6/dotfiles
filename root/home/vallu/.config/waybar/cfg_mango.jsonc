{
    "position": "top",
    "layer": "top",

    "modules-left": [
        "custom/archicon",
        "ext/workspaces",
        "custom/cpu",
        "custom/memory",
        "custom/temp",
        "custom/disc"
    ],

    "modules-center": [
        "custom/media",
        "custom/sepr",
        "custom/window"
    ],

    "modules-right": [
        "custom/notifications",
        "custom/brightness",
        "custom/vol",
        "battery",
        "custom/network",
        "custom/bt",
        "clock"
    ],

    "clock": {
        "format": "{:%a %d/%m <span color='#00AA00' weight='900'>%I:%M%p</span>}",
        "interval": 60
    },

    "battery": {
        "format": "<span font='12'>{icon}</span> {capacity}%",
        "format-critical": "<span font='12' color='#BB2000'>{icon}</span>\u2002 {capacity}%",
        "format-warning": "<span font='12' color='#FF9000'>{icon}</span>\u2002 {capacity}%",
        "format-normal": "<span font='12'>{icon}</span>\u2002 {capacity}%",
        "format-charging": "<span font='12' color='#00AA00'>{icon}</span>\u2002<span rise='700' color='#00AA00' font='12'>\udb85\udc0c</span> {capacity}%",
        "format-full": "<span font='12'>{icon}</span>  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": {
            "critical": 20,
            "warning": 40,
            "normal": 100
        }
    },

    "bluetooth": {
        "on-click-middle": "bluetoothctl power off",
        "on-click-right": "bluetoothctl power on",
        "format": "<span color='#FF5000' font='12'>\uf128</span>",
        "format-off": "<span font='12'>\udb80\udcb2</span>",
        "format-on": "<span color='#FFD145' font='12'>\udb80\udcaf</span>",
        "format-connected": "<span font='12' color='#00aa00'>\udb80\udcb1</span>",
        "tooltip": "true",
        "tooltip-markup": "true",
        "tooltip-format": "{controller_address}  •  {controller_alias}  •  {status}  •  {num_connections}",
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "<span font='12'>{icon}</span>",
        "format-icons": ["\udb80\udcde", "\udb80\udce0", "\udb80\udcda"],
        "tooltip": "true",
        "tooltip-format": "BRIGHTNESS {percent}%",
        "scroll-step": 5,
        "min-brightness": 5
    },

    "network": {
        "on-click-middle": "nmcli radio wifi off",
        "on-click-right": "nmcli radio wifi on",
        "format": "<span color='#FF5000' font='13'>\uf128</span>",
        "format-wifi": "<span color='#00aa00'>\uf1eb</span>",
        "format-ethernet": "<span color='#00aa00' font='15'>\udb80\ude01</span>",
        "format-disconnected": "<span color='#ff5000' font='14'>\udb84\udf83</span>",
        "format-disabled": "<span color='#ff5000' font='14'>\udb82\udfe1</span>",
        "tooltip": false,
        "tooltip-format": "<span color='#aaaaaa'>CTRLLER</span> {ifname}  <span color='#aaaaaa'>SSID</span> {essid}  <span color='#aaaaaa'>IP</span> {ipaddr}  <span color='#aaaaaa'>FREQ</span> {frequency}GHz  <span color='#aaaaaa'>STRENGTH</span> {signalStrength}%",
        "tooltip-markup": true
    },

    "pulseaudio": {
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ 1",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ 0",
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% <span font='12'>{icon} \udb80\udcaf</span>",
        "format-muted": "\uf466",
        "format-icons": {
            "headphone": "\uee58",
            "headset": "\uee58",
            "default": ["\uf027", "\uf028"]
        },
        "scroll-step": 5,
        "tooltip-format": "<span color='#aaaaaa'>VOLUME</span> {volume}% [{desc}]",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "dwl/window": {
        "icon": true,
        "format": "[{layout}] {app_id} · {title}",
        "max-length": 40
    },

    "cpu": {
        "interval": 3,
        "format": "<span font='12' color='#606060'>\uf4bc</span>\u2002 <span rise='500'>{usage}%</span>",
        "format-normal": "<span font='12' color='#00AA00'>\uf4bc</span>\u2002 <span rise='500'>{usage}%</span>",
        "format-high": "<span font='12' color='#FF8B00'>\uf4bc</span>\u2002 <span rise='500'>{usage}%</span>",
        "format-critical": "<span font='12' color='#FF1500'>\uf4bc</span>\u2002 <span rise='500'>{usage}%</span>",
        "tooltip": "true",
        "states": {
            "critical": 80,
            "high": 60,
            "normal": 0
        }
    },

    "memory": {
        "interval": 3,
        "format": "<span font='12' rise='2000' color='#606060'>\uefc5</span>\u2002 <span rise='2000'>{percentage}%</span>  <span rise='1500' font='12'>\udb83\udfb5</span>  <span rise='1500'>{swapPercentage}%</span>",
        "format-normal": "<span font='12' rise='2000' color='#00AA00'>\uefc5</span>\u2002 <span rise='2000'>{percentage}%</span>\u2002\u2002<span rise='1500' font='12'>\udb83\udfb5</span>\u2002<span rise='1500'>{swapPercentage}%</span>",
        "format-high": "<span font='12' rise='2000' color='#FF8B00'>\uefc5</span>\u2002 <span rise='2000'>{percentage}%</span>\u2002\u2002<span rise='1500' font='12'>\udb83\udfb5</span>\u2002<span rise='1500'>{swapPercentage}%</span>",
        "format-critical": "<span font='12' rise='2000' color='#FF1500'>\uefc5</span>\u2002 <span rise='2000'>{percentage}%</span>\u2002\u2002<span rise='1500' font='12'>\udb83\udfb5</span>\u2002<span rise='1500'>{swapPercentage}%</span>",
        "tooltip": true,
        "states": {
            "critical": 80,
            "high": 60,
            "normal": 0
        }
    },

    "disk": {
        "interval": 60,
        "format": "<span rise='-4000' font='13'>\udb80\udeca</span>\u2002<span rise='-2500'>{percentage_used}%</span>",
        "format-normal": "<span rise='-4000' font='13'>\udb80\udeca</span>\u2002<span rise='-2500'>{percentage_used}%</span>",
        "format-high": "<span rise='-4000' font='13' color='#'>\udb80\udeca</span>\u2002<span rise='-2500'>{percentage_used}%</span>",
        "format-critical": "<span rise='-4000' font='13' color='#aa0000'>\udb80\udeca</span>\u2002<span rise='-2500'>{percentage_used}%</span>",
        "unit": "GiB",
        "states": {
            "critical": 80,
        }
    },

    "wlr/taskbar": {
        "all-outputs": "false",
        "format": "{icon}",
        "icon-size": 19,
        "tooltip": true,
        "tooltip-format": "{app_id} · {title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        }
    },

    "custom/archicon": {
        "on-click-right": "xdg-open http://archlinux.org/news",
        "format": "<span color='#1793D1' font='15'>\udb82\udcc7</span>",
        "tooltip": true,
        "tooltip-format": "<span color='#ffffff'>OS</span> Arch Linux\n<span color='#ffffff'>WIN_MGR</span> Hyprland\n<span color='#ffffff'>STATUS_BAR</span> Waybar\n\n\"We all know Linux is great... \nit does infinite loops in 5 seconds.\"\n\n\"Only wimps use tape backup: \nreal men just upload their important \nstuff on ftp, and let the rest of the \nworld mirror it.\"\n\n\"… the Linux philosophy is 'laugh in \nthe face of danger.' Oops. Wrong one. \n'Do it yourself.' That's it.\"\n\n\"My name is Linus Torvalds and I am \nyour god.\"",
        "tooltip-markup": "true"
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network",
        "return-type": "json",
        "on-click-middle": "nmcli radio wifi off",
        "on-click-right": "nmcli radio wifi on",
    },

    "custom/bt": {
        "exec": "~/.config/waybar/scripts/bt",
        "return-type": "json",
        "on-click-middle": "bluetoothctl power off",
        "on-click-right": "bluetoothctl power on",
    },

    "custom/vol": {
        "exec": "~/.config/waybar/scripts/vol",
        "return-type": "json",
        "interval": 0.3,
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ 1",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ 0",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    },

   "custom/brightness": {
       "exec": "~/.config/waybar/scripts/brightness",
       "interval": 1,
       "on-scroll-up":   "~/.config/waybar/scripts/brightness --inc",
       "on-scroll-down": "~/.config/waybar/scripts/brightness --dec",
       "return-type": "json"
   },

    "custom/window": {
        "exec": "~/.config/waybar/scripts/scroll_title",
        "return-type": "json"
    },
    
    "custom/temp": {
        "exec": "~/.config/waybar/scripts/temp",
        "return-type": "json"
    },

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu",
        "return-type": "json"
    },

    "custom/memory": {
        "exec": "~/.config/waybar/scripts/mem",
        "return-type": "json"
    },

    "custom/disc": {
        "exec": "~/.config/waybar/scripts/disc",
        "return-type": "json"
    },

    "custom/datetime": {
        "exec": "~/.config/waybar/scripts/datetime",
        "return-type": "json"
    },

    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.py",
        "return-type": "json",
        "restart-interval": 3,
        "on-click":        "~/.config/waybar/scripts/media.py playpause",
        "on-click-right":  "~/.config/waybar/scripts/media.py next",
        "on-click-middle": "~/.config/waybar/scripts/media.py prev",
        "escape": true
    },

    "custom/notifications": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
           "notification": "\uF0A2<span foreground='red'><sup>\uF444</sup></span>",
           "none": "\uF0A2",
           "dnd-notification": "\uF1F7<span foreground='red'><sup>\uF444</sup></span>",
           "dnd-none": "\uF1F7",
           "inhibited-notification": "\uF0A2<span foreground='red'><sup>\uF444</sup></span>",
           "inhibited-none": "\uF0A2",
           "dnd-inhibited-notification": "\uF1F7<span foreground='red'><sup>\uF444</sup></span>",
           "dnd-inhibited-none": "\uF1F7"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/sepr": {
        "format": "•",
        "class": "separator"
    }
}
